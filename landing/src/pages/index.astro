    <div>
      <a class="brand" href="/"><img src="/logo.png" alt="" />Trabajo<b>gpt</b></a>
      <p style="margin-top:.75rem;max-width:20rem;line-height:1.5rem">Todas las ofertas de Uruguay en un lugar, ordenadas por cuánto encajan con tu CV.</p>
    </div>
    <div><h4>Explorar</h4><a href={`${APP}/ofertas`}>Ofertas</a><a href={`${APP}/mapa`}>Empleos por departamento</a><a href="#rubros">Rubros</a><a href="#faq">Preguntas frecuentes</a></div>
    <div><h4>Legal</h4><a href={`${APP}/privacidad`}>Privacidad</a><a href={`${APP}/terminos`}>Términos</a></div>
