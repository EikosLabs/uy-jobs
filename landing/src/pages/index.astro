  <div class="stickycta" style="display:none"></div>

  <script type="application/ld+json">
  {"@context":"https://schema.org","@type":"FAQPage","mainEntity":[
    {"@type":"Question","name":"¿Es gratis trabajogpt?","acceptedAnswer":{"@type":"Answer","text":"Sí, crear cuenta y ver ofertas es gratis."}},
    {"@type":"Question","name":"¿De dónde salen las ofertas?","acceptedAnswer":{"@type":"Answer","text":"De Computrabajo, BuscoJobs, LinkedIn e Indeed, actualizadas a diario."}},
    {"@type":"Question","name":"¿Cómo funcionan los avisos de match?","acceptedAnswer":{"@type":"Answer","text":"Subís tu CV y te avisamos cuando aparece una oferta que encaja con tu perfil."}},
    {"@type":"Question","name":"¿Puedo llevar control de mis postulaciones?","acceptedAnswer":{"@type":"Answer","text":"Sí, con estados y exportación a CSV."}},
