  ]}
  </script>

  <script>
    // reveals
    const io = new IntersectionObserver((es) => {
      es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); } });
    }, { threshold: 0.12 });
    document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
    // tagline palabra por palabra
    const tag = document.getElementById("tagline-text");
    if (tag) {
      const words = tag.textContent.trim().split(/\s+/);
      tag.innerHTML = words.map((w) => `<span>${w}</span>`).join(" ");
      const spans = [...tag.querySelectorAll("span")];
      const tio = new IntersectionObserver((es) => {
        es.forEach((e) => {
          if (!e.isIntersecting) return;
          spans.forEach((sp, i) => setTimeout(() => sp.classList.add("on"), i * 90));
          tio.disconnect();
        });
      }, { threshold: 0.4 });
      tio.observe(tag);
    }
    // menú móvil
    const burger = document.getElementById("burger");
    const overlay = document.getElementById("overlay");
    if (burger && overlay) {
      const toggle = (open) => {
        burger.classList.toggle("open", open);
        overlay.classList.toggle("open", open);
        burger.setAttribute("aria-expanded", String(open));
        document.body.style.overflow = open ? "hidden" : "";
      };
      burger.addEventListener("click", () => toggle(!overlay.classList.contains("open")));
      overlay.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => toggle(false)));
    }
    document.querySelectorAll("[data-track]").forEach((el) => {
      el.addEventListener("click", () => {
        try {
          fetch("/api/track", { method: "POST", headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ event: "cta_hero_clicked", path: "/", props: { cta: el.getAttribute("data-track") || "" } }) });
        } catch {}
      });
    });
    // Sesión compartida con la app (mismo dominio): si ya entraste, la landing te lleva adentro.
    let logged = false;
    const toApp = (path) => (logged ? path : "/register?next=" + encodeURIComponent(path));
    fetch("/api/session", { credentials: "same-origin" }).then((r) => r.json()).then((s) => {
      if (!s.logged) return;
      logged = true;
      document.body.classList.add("logged");
      const hello = document.getElementById("hello");
      if (hello && s.nombre) hello.textContent = "Hola, " + s.nombre;
      document.querySelectorAll("[data-cta]").forEach((a) => {
        if (a.dataset.loggedHref) a.href = a.dataset.loggedHref;
        if (a.dataset.loggedText) a.textContent = a.dataset.loggedText;
      });
      document.querySelectorAll("[data-path]").forEach((a) => { a.href = a.dataset.path; });
    }).catch(() => {});
    fetch("/api/public/stats").then((r) => r.json()).then((d) => {
      const f = (n) => (n > 0 ? n.toLocaleString("es-UY") : "…");
      const set = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };
      set("st-total", f(d.total));
      set("h-count", d.total > 0 ? f(d.total) : "Miles de");
      set("proof", `${f(d.total)} avisos · 4 fuentes · actualizados a diario · gratis`);
      const AVC = [["#dbeafe","#0038a8"],["#fef9c3","#854d0e"],["#fcd116","#0a2156"],["#e0f2fe","#0c4a6e"],["#ffffff","#0038a8"],["#bbf7d0","#14532d"]];
      const box = document.getElementById("cats");
      const scroll = document.getElementById("catscroll");
      if (d.topCats?.length) {
        const html = d.topCats.map((t) => {
          const k = t.categoria || "otros";
          const href = k === "otros" ? "https://trabajogpt.eikoslabs.com/register" : `https://trabajogpt.eikoslabs.com/trabajos/${k.replace(/_/g, "-")}`;
          return `<a class="cat" href="${href}"><b>${catLabel(k)}</b><span>${t.n.toLocaleString("es-UY")} avisos</span></a>`;
        }).join("");
        if (box) box.innerHTML = html;
        if (scroll) scroll.innerHTML = html;
      }
      const live = document.getElementById("live-list");
      if (d.latest?.length) {
        live.innerHTML = "";
        d.latest.forEach((o, idx) => {
          const li = document.createElement("li");
          const a = document.createElement("a");
          a.dataset.path = "/oferta/" + o.id;
          a.href = toApp(a.dataset.path);
          const name = (o.empresa || "?").trim();
          let h = 0;
          for (const ch of name) h = (h * 31 + ch.charCodeAt(0)) % AVC.length;
          const av = document.createElement("span");
          av.className = "av";
          av.style.background = AVC[h][0];
          av.style.color = AVC[h][1];
          av.textContent = name.split(/\s+/).slice(0, 2).map((w) => w[0]).join("").toUpperCase() || "•";
          const tx = document.createElement("div");
          tx.className = "txt";
          const b = document.createElement("b");
          b.textContent = o.titulo || "(sin título)";
          const meta = document.createElement("span");
          meta.className = "meta";
          meta.textContent = [o.empresa, place(o.ubicacion)].filter(Boolean).join(" · ");
          tx.appendChild(b); tx.appendChild(meta);
          const side = document.createElement("span");
          side.style.cssText = "flex-shrink:0;display:flex;flex-direction:column;align-items:flex-end;gap:.25rem";
          const tm = document.createElement("time");
          tm.textContent = ago(o.fecha_scrapeo);
          const ct = document.createElement("span");
          ct.className = "sidecat";
          ct.textContent = catLabel(o.categoria);
          side.appendChild(tm); side.appendChild(ct);
          a.appendChild(av); a.appendChild(tx); a.appendChild(side);
          if (idx === 0) li.className = "feat";
          li.appendChild(a);
          live.appendChild(li);
        });
      }
      const n = (id, v) => set(id, v);
      n("n-total", f(d.total));
      n("n-remoto", f(d.remotos));
      n("n-users", f(d.users));
    }).catch(() => {});
    const CAT_LABEL = {"tecnologia": "Tecnología", "ventas": "Ventas", "administracion": "Administración", "logistica": "Logística", "atencion_cliente": "Atención al cliente", "gerencia": "Gerencia", "oficios": "Oficios", "operarios": "Operarios", "salud": "Salud", "marketing": "Marketing", "hoteleria_turismo": "Hotelería y turismo", "gastronomia": "Gastronomía", "educacion": "Educación", "otros": "Otros rubros"};
    function catLabel(k) { return CAT_LABEL[k || "otros"] || String(k).replace(/_/g, " "); }
    function place(u) {
      if (!u) return "";
      const seen = new Set();
      return u.split(",").map((p) => p.replace(/^\s*Departamento de\s+/i, "").trim()).filter((p) => {
        const k = p.toLowerCase();
        if (!p || seen.has(k)) return false;
        seen.add(k);
        return true;
      }).join(", ");
    }
    function ago(iso) {
      if (!iso) return "";
      const m = Math.max(0, Math.round((Date.now() - new Date(iso).getTime()) / 60000));
      if (m < 1) return "ahora mismo";
      if (m < 60) return "hace " + m + " min";
      const h = Math.round(m / 60);
      if (h < 24) return "hace " + h + " h";
      const dd = Math.round(h / 24);
      return dd === 1 ? "ayer" : "hace " + dd + " días";
    }
  </script>
</body>
